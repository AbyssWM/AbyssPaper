[Unit]
Description=Fast, IPC-controlled wallpaper utility for Abyssland.
Documentation=https://wiki.abyssland.org/Abyss-Ecosystem/abysspaper/
PartOf=graphical-session.target
Requires=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/abysspaper
Slice=session.slice
Restart=on-failure

[Install]
WantedBy=graphical-session.target
